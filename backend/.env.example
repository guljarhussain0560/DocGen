# Application settings
APP_NAME="DocGen AI Agent"
APP_VERSION="1.0.0"
DEBUG=True

# Groq AI Settings
GROQ_API_KEY="your-groq-api-key"
AI_MODEL="llama-3.3-70b-versatile"
AI_MAX_TOKENS=4096

# Database Settings
# For local dev sqlite: sqlite+aiosqlite:///./docgen.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL="sqlite+aiosqlite:///./docgen.db"

# GitHub Integration (Optional but needed for pulling PRs/Repos dynamically)
GITHUB_TOKEN="your-github-personal-access-token"
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"

# Storage Settings
DOCS_OUTPUT_DIR="./generated_docs"
MAX_FILE_SIZE_MB=10

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
